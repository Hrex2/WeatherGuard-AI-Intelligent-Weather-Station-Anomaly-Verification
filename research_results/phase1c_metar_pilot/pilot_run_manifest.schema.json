{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weatherguard.example/schemas/pilot-run-manifest.schema.json",
  "title": "WeatherGuard Phase 1C METAR Pilot Run Manifest",
  "description": "Schema for a future, explicitly approved pilot run. No instance is created during preparation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "retrieval_timestamp_utc", "stations", "provider", "parameters", "start_date_inclusive", "end_date_inclusive", "end_boundary_exclusive", "frequency", "source_timezone", "package_version", "artifact_type", "approval_state", "files", "raw_observation_download_started"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "retrieval_timestamp_utc": {"type": "string", "format": "date-time"},
    "stations": {"const": ["VILD0", "42105"]},
    "provider": {"const": "METAR"},
    "parameters": {"const": ["temp", "rhum", "wspd", "wdir", "pres"]},
    "start_date_inclusive": {"const": "2025-09-01"},
    "end_date_inclusive": {"const": "2025-09-30"},
    "end_boundary_exclusive": {"const": "2025-10-01"},
    "frequency": {"const": "hourly"},
    "source_timezone": {"const": "UTC (naive package timestamps)"},
    "package_version": {"const": "2.2.3"},
    "artifact_type": {"const": "Meteostat Python TimeSeries DataFrame export; not original HTTP response bytes"},
    "approval_state": {"const": "APPROVED_AT_EXECUTION"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "station_id"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "station_id": {"enum": ["VILD0", "42105"]}
        }
      }
    },
    "raw_observation_download_started": {"const": true}
  }
}
